SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=https://your-app.up.railway.app

# Local dev — SQLite (no Turso vars needed)
DB_PATH=./data/locus.db

# Railway / Production — Turso (uncomment and fill in)
# TURSO_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

PORT=5001

# SMTP Email (for verification codes & feedback delivery)
# Without SMTP_HOST, emails are printed to logs in dev mode
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=your-email@gmail.com
# FEEDBACK_TO_EMAIL=support@locusadvisory.com